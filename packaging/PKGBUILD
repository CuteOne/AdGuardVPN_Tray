# Maintainer: Ashley <ph34rt3hcute1@gmail.com>
#
# Build locally with: cd packaging && makepkg -si

pkgname=adguardvpn-tray
# The GitHub repo name differs from the package name; its release tarball
# unpacks to "$_reponame-$pkgver" (GitHub drops the tag's leading "v").
_reponame=AdGuardVPN_Tray
pkgver=0.1.0
pkgrel=1
pkgdesc="KDE Plasma system tray application for managing AdGuard VPN via adguardvpn-cli"
arch=('any')
url="https://github.com/CuteOne/$_reponame"
license=('MIT')
depends=('pyside6' 'python-pexpect')
makedepends=('python-build' 'python-installer' 'python-wheel')
optdepends=('adguardvpn-cli: the VPN client this app manages')
install="${pkgname}.install"
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
	cd "$_reponame-$pkgver"
	python -m build --wheel --no-isolation
}

package() {
	cd "$_reponame-$pkgver"
	python -m installer --destdir="$pkgdir" dist/*.whl
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	install -Dm644 packaging/adguardvpn-tray.desktop "$pkgdir/usr/share/applications/adguardvpn-tray.desktop"
	install -Dm644 src/adguardvpn_tray/resources/icons/connected.png "$pkgdir/usr/share/pixmaps/adguardvpn-tray.png"
}
